import { SubjectItem, TipItem, SettingsData, TrackItem, TodoItem, NoteItem, MdBlock, BarItem, SessionRow, DistractionRow } from "structs.slint";

// Shared state between Rust and the screens. Rust owns the data; the UI only
// reads properties and invokes callbacks.
export global AppState {
    in-out property <string> status-line;
    in-out property <string> toast;
    in-out property <string> hotkey-status;

    // ----- timer -----
    in-out property <string> timer-text: "25:00";
    in-out property <string> phase-label: "Ready";
    in-out property <float> timer-progress: 0;
    in-out property <bool> timer-active: false;
    in-out property <bool> timer-running: false;
    in-out property <bool> timer-awaiting: false;
    in-out property <bool> timer-is-break: false;
    in-out property <int> timer-mode: 0;           // 0 pomodoro, 1 flow
    in-out property <string> session-info;
    in-out property <string> break-tip;
    in-out property <string> active-goal;

    // ----- subjects -----
    in-out property <[SubjectItem]> subjects;
    in-out property <[string]> subject-names: ["No subject"]; // index 0 = none
    in-out property <int> focus-subject: 0;

    // ----- outcome prompt (after a session) -----
    in-out property <bool> outcome-open: false;
    in-out property <string> outcome-goal;
    in-out property <string> outcome-summary;

    // ----- settings -----
    in-out property <SettingsData> settings;
    in-out property <[TipItem]> tips;

    // ----- sounds -----
    in-out property <[TrackItem]> tracks;
    in-out property <bool> sounds-playing: false;
    in-out property <string> audio-status;
    callback set-track-volume(string, float);
    callback toggle-sounds();
    callback open-sounds-folder();
    callback rescan-sounds();

    // ----- dashboard -----
    in-out property <string> dash-today-text: "0m";
    in-out property <float> dash-today-progress: 0;
    in-out property <string> dash-today-sub: "";
    in-out property <string> dash-week-text: "0m";
    in-out property <float> dash-week-progress: 0;
    in-out property <string> dash-week-sub: "";
    in-out property <int> dash-streak: 0;
    in-out property <int> dash-freezes: 0;
    in-out property <string> dash-streak-note: "";
    in-out property <int> dash-cards-due: 0;
    in-out property <string> dash-block-status: "Blocking helper not installed";
    in-out property <[TodoItem]> next-tasks;

    // ----- tasks -----
    in-out property <[TodoItem]> todos;
    in-out property <int> task-filter: 0;   // 0 all, 1 open, 2 done, 3 overdue
    in-out property <int> task-sort: 0;     // 0 due, 1 priority, 2 newest
    in-out property <string> task-error;
    callback add-todo(string, int, string, int);
    callback toggle-todo(int, bool);
    callback delete-todo(int);
    callback set-task-view(int, int);

    // ----- notes -----
    in-out property <[NoteItem]> notes;
    in-out property <[string]> note-filter-names: ["All subjects"];
    in-out property <int> note-filter: 0;
    in-out property <int> current-note-id: -1;
    in-out property <string> note-title;
    in-out property <string> note-body;
    in-out property <int> note-subject: 0;
    in-out property <[MdBlock]> note-blocks;
    in-out property <int> note-load-seq: 0;
    in-out property <string> note-saved: "";
    callback new-note();
    callback select-note(int);
    callback edit-note(string, string, int);
    callback delete-note();
    callback search-notes(int, string);

    // ----- stats -----
    in-out property <string> stats-today;
    in-out property <string> stats-week;
    in-out property <string> stats-month;
    in-out property <string> stats-all;
    in-out property <[BarItem]> stats-subject-bars;
    in-out property <[BarItem]> stats-day-bars;
    in-out property <[BarItem]> stats-hour-bars;
    in-out property <[BarItem]> stats-app-bars;
    in-out property <[SessionRow]> stats-sessions;
    in-out property <[DistractionRow]> stats-distractions;

    // ----- timer callbacks -----
    callback start-session(int /*mode*/, int /*subject idx*/, string /*goal*/);
    callback toggle-pause();
    callback skip-phase();
    callback stop-session();
    callback submit-outcome(int /*0 done 1 partly 2 not*/, string /*note*/);

    // ----- settings callbacks -----
    callback set-int(string, int);
    callback set-bool(string, bool);
    callback set-float(string, float);
    callback set-str(string, string);
    callback add-subject(string, color);
    callback delete-subject(int);
    callback add-tip(string);
    callback delete-tip(int);
}

import { SubjectItem, TipItem, SettingsData, TrackItem, TodoItem, NoteItem, MdBlock, BarItem, SessionRow, DistractionRow, DeckRow, CardRow, CsvRow, ListItem, ScheduleItem } from "structs.slint";

// Shared state between Rust and the screens. Rust owns the data; the UI only
// reads properties and invokes callbacks.
export global AppState {
    in-out property <string> status-line;
    in-out property <string> toast;
    in-out property <string> hotkey-status;

    // ----- timer -----
    in-out property <string> timer-text: "25:00";
    in-out property <string> phase-label: "Ready";
    in-out property <float> timer-progress: 0;
    in-out property <bool> timer-active: false;
    in-out property <bool> timer-running: false;
    in-out property <bool> timer-awaiting: false;
    in-out property <bool> timer-is-break: false;
    in-out property <int> timer-mode: 0;           // 0 pomodoro, 1 flow
    in-out property <string> session-info;
    in-out property <string> break-tip;
    in-out property <string> active-goal;

    // ----- subjects -----
    in-out property <[SubjectItem]> subjects;
    in-out property <[string]> subject-names: ["No subject"]; // index 0 = none
    in-out property <int> focus-subject: 0;
    in-out property <string> focus-goal;

    // ----- outcome prompt (after a session) -----
    in-out property <bool> outcome-open: false;
    in-out property <string> outcome-goal;
    in-out property <string> outcome-summary;

    // ----- settings -----
    in-out property <SettingsData> settings;
    in-out property <[TipItem]> tips;

    // ----- sounds -----
    in-out property <[TrackItem]> tracks;
    in-out property <bool> sounds-playing: false;
    in-out property <string> audio-status;
    callback set-track-volume(string, float);
    callback toggle-sounds();
    callback open-sounds-folder();
    callback rescan-sounds();

    // ----- dashboard -----
    in-out property <string> dash-today-text: "0m";
    in-out property <float> dash-today-progress: 0;
    in-out property <string> dash-today-sub: "";
    in-out property <string> dash-week-text: "0m";
    in-out property <float> dash-week-progress: 0;
    in-out property <string> dash-week-sub: "";
    in-out property <int> dash-streak: 0;
    in-out property <int> dash-freezes: 0;
    in-out property <string> dash-streak-note: "";
    in-out property <int> dash-cards-due: 0;
    in-out property <string> dash-block-status: "Blocking helper not installed";
    in-out property <[TodoItem]> next-tasks;

    // ----- tasks -----
    in-out property <[TodoItem]> todos;
    in-out property <int> task-filter: 0;   // 0 all, 1 open, 2 done, 3 overdue
    in-out property <int> task-sort: 0;     // 0 due, 1 priority, 2 newest
    in-out property <string> task-error;
    callback add-todo(string, int, string, int);
    callback toggle-todo(int, bool);
    callback delete-todo(int);
    callback set-task-view(int, int);

    // ----- notes -----
    in-out property <[NoteItem]> notes;
    in-out property <[string]> note-filter-names: ["All subjects"];
    in-out property <int> note-filter: 0;
    in-out property <int> current-note-id: -1;
    in-out property <string> note-title;
    in-out property <string> note-body;
    in-out property <int> note-subject: 0;
    in-out property <[MdBlock]> note-blocks;
    in-out property <int> note-load-seq: 0;
    in-out property <string> note-saved: "";
    callback new-note();
    callback select-note(int);
    callback edit-note(string, string, int);
    callback delete-note();
    callback search-notes(int, string);

    // ----- flashcards -----
    in-out property <[DeckRow]> decks;
    in-out property <int> fc-mode: 0;            // 0 decks, 1 review, 2 browse
    in-out property <string> fc-message;
    in-out property <string> review-deck;
    in-out property <string> review-front;
    in-out property <string> review-back;
    in-out property <bool> review-answer-shown: false;
    in-out property <int> review-remaining: 0;
    in-out property <[string]> review-labels: ["<1d", "1d", "1d", "4d"];
    in-out property <bool> review-finished: false;
    in-out property <string> review-summary;
    in-out property <string> browse-deck-name;
    in-out property <[CardRow]> browse-cards;
    in-out property <bool> import-open: false;
    in-out property <int> import-kind: 0;       // 0 csv, 1 apkg
    in-out property <string> import-file;
    in-out property <string> import-info;
    in-out property <string> import-error;
    in-out property <[string]> import-cols;
    in-out property <[string]> import-tag-cols: ["(none)"];
    in-out property <[CsvRow]> import-raw;
    in-out property <[CsvRow]> import-preview;
    in-out property <int> import-map-front: 0;
    in-out property <int> import-map-back: 1;
    in-out property <int> import-map-tags: 0;
    in-out property <bool> import-header: false;
    in-out property <[string]> import-deck-names: ["New deck…"];
    callback add-deck(string, int);
    callback delete-deck(int);
    callback study-deck(int);
    callback show-answer();
    callback rate-card(int);
    callback end-review();
    callback browse-deck(int);
    callback close-browse();
    callback add-card(string, string);
    callback delete-card(int);
    callback pick-import(int);
    callback csv-update(int, int, int, bool);
    callback import-confirm(int, string);
    callback import-cancel();

    // ----- blocking -----
    in-out property <bool> helper-connected: false;
    in-out property <string> helper-status;       // one-line summary
    in-out property <string> helper-detail;       // warnings / hints
    in-out property <string> helper-install-note;
    in-out property <[ListItem]> blocklists;
    in-out property <int> edit-list-id: -1;
    in-out property <string> edit-name;
    in-out property <string> edit-domains;
    in-out property <string> edit-processes;
    in-out property <bool> edit-steam: false;
    in-out property <int> edit-mode: 0;
    in-out property <bool> edit-preset: false;
    in-out property <int> edit-seq: 0;
    in-out property <string> edit-error;
    callback toggle-list-selected(int, bool);
    callback set-list-mode(int, int);
    callback edit-list(int);
    callback new-list();
    callback save-list(int, string, string, string, bool, int);
    callback duplicate-list(int);
    callback delete-list(int);
    callback install-helper();

    // ----- schedules -----
    in-out property <[ScheduleItem]> schedules;
    in-out property <[string]> list-names;
    in-out property <string> schedule-error;
    callback add-schedule(int /*list idx*/, int /*days mask*/, string, string);
    callback toggle-schedule(int, bool);
    callback delete-schedule(int);

    // ----- hard mode -----
    in-out property <bool> hard-on: false;
    in-out property <int> hard-mins: 50;
    in-out property <bool> hard-active: false;
    in-out property <string> hard-until;
    in-out property <string> hard-left;
    in-out property <bool> hard-challenge-enabled: false;
    in-out property <string> hard-challenge;
    in-out property <string> hard-cooldown;
    in-out property <string> hard-emergency;
    in-out property <int> hard-cooldown-mins: 20;
    in-out property <int> hard-emergency-mins: 60;
    in-out property <string> hard-error;
    callback hard-challenge-submit(string);
    callback hard-cooldown-request(bool);
    callback hard-emergency-request(bool);

    // ----- system -----
    in-out property <string> dnd-status;
    in-out property <string> data-dir;
    in-out property <string> data-note;
    callback choose-data-dir();
    callback reset-data-dir();
    callback open-data-dir();
    callback backup-now();

    // ----- overlay / misc -----
    in-out property <string> flash;

    // ----- stats -----
    in-out property <string> stats-today;
    in-out property <string> stats-week;
    in-out property <string> stats-month;
    in-out property <string> stats-all;
    in-out property <[BarItem]> stats-subject-bars;
    in-out property <[BarItem]> stats-day-bars;
    in-out property <[BarItem]> stats-hour-bars;
    in-out property <[BarItem]> stats-app-bars;
    in-out property <[SessionRow]> stats-sessions;
    in-out property <[DistractionRow]> stats-distractions;

    // ----- timer callbacks -----
    callback start-session(int /*mode*/, int /*subject idx*/, string /*goal*/, bool /*hard*/, int /*hard minutes*/);
    callback toggle-pause();
    callback skip-phase();
    callback stop-session();
    callback submit-outcome(int /*0 done 1 partly 2 not*/, string /*note*/);

    // ----- settings callbacks -----
    callback set-int(string, int);
    callback set-bool(string, bool);
    callback set-float(string, float);
    callback set-str(string, string);
    callback add-subject(string, color);
    callback delete-subject(int);
    callback add-tip(string);
    callback delete-tip(int);
}

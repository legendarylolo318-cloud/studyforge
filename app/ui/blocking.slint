import { ComboBox, LineEdit, TextEdit, CheckBox, Switch, ScrollView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { AppState } from "state.slint";
import { Card, Dim, PrimaryButton, GhostButton, Pill } from "components.slint";
import { ListItem } from "structs.slint";

component HelperCard inherits Card {
    VerticalLayout {
        padding: 16px; spacing: 6px;
        HorizontalLayout {
            spacing: 8px;
            Rectangle { width: 12px; height: 12px; border-radius: 6px; y: 4px; background: AppState.helper-connected ? Theme.ok : Theme.warn; }
            Text { text: AppState.helper-connected ? "Blocking helper connected" : "Blocking helper not installed"; font-size: 16px; font-weight: 700; color: Theme.text; horizontal-stretch: 1; }
            if !AppState.helper-connected: PrimaryButton { text: "Install…"; clicked => { AppState.install-helper(); } }
        }
        Dim { text: AppState.helper-status; }
        if AppState.helper-detail != "": Text { text: AppState.helper-detail; color: Theme.warn; wrap: word-wrap; font-size: 12px; }
        if !AppState.helper-connected: Dim { text: AppState.helper-install-note; }
        if !AppState.helper-connected: Dim { text: "Timers, flashcards, notes, tasks and stats work without it. Only blocking needs the helper."; }
    }
}

component ListRow inherits Rectangle {
    in property <ListItem> item;
    height: 50px; border-radius: 8px;
    background: item.editing ? Theme.accent.with-alpha(0.18) : (ta.has-hover ? Theme.surface-hi : transparent);
    ta := TouchArea { clicked => { AppState.edit-list(item.id); } mouse-cursor: pointer; }
    HorizontalLayout {
        padding-left: 8px; padding-right: 8px; spacing: 8px;
        CheckBox { checked: item.selected; toggled => { AppState.toggle-list-selected(item.id, self.checked); } }
        VerticalLayout {
            alignment: center; horizontal-stretch: 1;
            Text { text: item.name; color: Theme.text; font-weight: 700; overflow: elide; }
            Dim { text: item.domains + " sites · " + item.processes + " apps" + (item.steam ? " · Steam games" : ""); }
        }
        VerticalLayout {
            alignment: center;
            Pill { text: item.mode == 0 ? "Hard" : "Gentle"; tint: item.mode == 0 ? Theme.danger : Theme.warn; }
        }
        if item.preset: VerticalLayout { alignment: center; Pill { text: "preset"; tint: Theme.text-dim; } }
    }
}

component ListEditor inherits Card {
    property <int> mode: AppState.edit-mode;
    property <bool> steam: AppState.edit-steam;
    property <int> seq: AppState.edit-seq;
    changed seq => { name.text = AppState.edit-name; domains.text = AppState.edit-domains; procs.text = AppState.edit-processes; root.mode = AppState.edit-mode; root.steam = AppState.edit-steam; }
    init => { name.text = AppState.edit-name; domains.text = AppState.edit-domains; procs.text = AppState.edit-processes; }
    VerticalLayout {
        padding: 14px; spacing: 8px;
        Text { text: AppState.edit-preset ? "Preset (read-only list — duplicate it to customise)" : "Edit list"; font-weight: 700; color: Theme.text; }
        name := LineEdit { placeholder-text: "List name"; enabled: !AppState.edit-preset; }
        HorizontalLayout {
            spacing: 8px;
            Dim { text: "When a blocked app starts:"; vertical-alignment: center; }
            GhostButton { text: "Close it (hard)"; selected: root.mode == 0; clicked => { root.mode = 0; if (AppState.edit-preset) { AppState.set-list-mode(AppState.edit-list-id, 0); } } }
            GhostButton { text: "Ask me (gentle)"; selected: root.mode == 1; clicked => { root.mode = 1; if (AppState.edit-preset) { AppState.set-list-mode(AppState.edit-list-id, 1); } } }
        }
        HorizontalLayout {
            spacing: 8px; vertical-stretch: 1;
            VerticalLayout {
                horizontal-stretch: 1; spacing: 4px;
                Dim { text: "Websites (one domain per line; subdomains must be listed). Domains only — IP addresses are ignored."; }
                domains := TextEdit { read-only: AppState.edit-preset; wrap: word-wrap; font-size: 12px; }
            }
            VerticalLayout {
                horizontal-stretch: 1; spacing: 4px;
                Dim { text: "Programs (process names, e.g. discord — case-insensitive, .exe optional)"; }
                procs := TextEdit { read-only: AppState.edit-preset; wrap: word-wrap; font-size: 12px; }
            }
        }
        HorizontalLayout {
            spacing: 8px;
            Switch { checked: root.steam; enabled: !AppState.edit-preset; toggled => { root.steam = self.checked; } }
            Text { text: "Block Steam games (the Steam client itself is never touched unless enabled in Settings)"; color: Theme.text; wrap: word-wrap; vertical-alignment: center; horizontal-stretch: 1; font-size: 12px; }
        }
        if AppState.edit-error != "": Text { text: AppState.edit-error; color: Theme.danger; wrap: word-wrap; }
        HorizontalLayout {
            spacing: 8px; alignment: end;
            GhostButton { text: "Duplicate"; clicked => { AppState.duplicate-list(AppState.edit-list-id); } }
            if !AppState.edit-preset: GhostButton { text: "Delete"; clicked => { AppState.delete-list(AppState.edit-list-id); } }
            if !AppState.edit-preset: PrimaryButton { text: "Save"; clicked => { AppState.save-list(AppState.edit-list-id, name.text, domains.text, procs.text, root.steam, root.mode); } }
        }
    }
}

component AllowlistCard inherits Card {
    VerticalLayout {
        padding: 16px; spacing: 8px;
        HorizontalLayout {
            spacing: 10px;
            Text { text: "Allowlist mode"; font-size: 16px; font-weight: 700; color: Theme.text; horizontal-stretch: 1; vertical-alignment: center; }
            Switch { checked: AppState.settings.allowlist-mode; toggled => { AppState.set-bool("allowlist_mode", self.checked); } }
        }
        Dim { text: "Instead of blocking only what is listed, block everything except what you allow. Websites: all sites are blocked except the ones below. Programs: only programs from the lists you ticked (your 'distraction category') are closed, unless they are allowed below — other programs are never touched."; }
        Text {
            text: AppState.settings.browser-policies ? "Website allowlisting works through browser policies (enabled)." : "⚠ Website allowlisting REQUIRES browser policies, and they are switched off in Settings — websites will not be restricted.";
            color: AppState.settings.browser-policies ? Theme.ok : Theme.danger; wrap: word-wrap; font-size: 12px;
        }
        HorizontalLayout {
            spacing: 10px; height: 110px;
            VerticalLayout {
                horizontal-stretch: 1; spacing: 4px;
                Dim { text: "Allowed websites (one per line)"; }
                al-dom := TextEdit { wrap: word-wrap; font-size: 12px; edited(t) => { AppState.set-str("allowlist_domains", t); } }
            }
            VerticalLayout {
                horizontal-stretch: 1; spacing: 4px;
                Dim { text: "Allowed programs (one per line)"; }
                al-proc := TextEdit { wrap: word-wrap; font-size: 12px; edited(t) => { AppState.set-str("allowlist_processes", t); } }
            }
        }
    }
    init => { al-dom.text = AppState.settings.allowlist-domains; al-proc.text = AppState.settings.allowlist-processes; }
}

component ScheduleCard inherits Card {
    property <int> days: 31;   // Mon-Fri
    VerticalLayout {
        padding: 16px; spacing: 8px;
        Text { text: "Scheduled blocking"; font-size: 16px; font-weight: 700; color: Theme.text; }
        Dim { text: "Runs in the background helper even when this window is closed and no session is running. Times are local wall-clock; ranges may cross midnight (22:00–02:00, days refer to the day the range starts)."; }
        for sc in AppState.schedules : HorizontalLayout {
            spacing: 8px; height: 30px;
            Switch { checked: sc.enabled; toggled => { AppState.toggle-schedule(sc.id, self.checked); } }
            Text { text: sc.lists; color: Theme.text; vertical-alignment: center; width: 170px; overflow: elide; }
            Text { text: sc.days; color: Theme.text-dim; vertical-alignment: center; width: 120px; }
            Text { text: sc.time; color: Theme.text-dim; vertical-alignment: center; horizontal-stretch: 1; }
            GhostButton { text: "✕"; min-width: 30px; height: 26px; clicked => { AppState.delete-schedule(sc.id); } }
        }
        if AppState.schedules.length == 0: Dim { text: "No schedules yet."; }
        Rectangle { height: 1px; background: Theme.border; }
        HorizontalLayout {
            spacing: 6px;
            sc-list := ComboBox { model: AppState.list-names; width: 180px; }
            for d[i] in ["Mo", "Tu", "We", "Th", "Fr", "Sa", "Su"] : GhostButton {
                text: d; min-width: 34px; selected: (root.days / Math.pow(2, i)) - 2 * Math.floor((root.days / Math.pow(2, i)) / 2) >= 1;
                clicked => {
                    if (self.selected) { root.days = root.days - Math.round(Math.pow(2, i)); } else { root.days = root.days + Math.round(Math.pow(2, i)); }
                }
            }
            sc-start := LineEdit { text: "09:00"; width: 70px; }
            Dim { text: "to"; vertical-alignment: center; }
            sc-end := LineEdit { text: "17:00"; width: 70px; }
            PrimaryButton { text: "Add"; clicked => { AppState.add-schedule(sc-list.current-index, root.days, sc-start.text, sc-end.text); } }
        }
        if AppState.schedule-error != "": Text { text: AppState.schedule-error; color: Theme.danger; font-size: 12px; wrap: word-wrap; }
    }
}

component PolicyNote inherits Card {
    VerticalLayout {
        padding: 16px; spacing: 6px;
        Text { text: "How website blocking works"; font-size: 16px; font-weight: 700; color: Theme.text; }
        Dim { text: "Layer 1 — hosts file: blocked domains are mapped to 0.0.0.0 and :: between StudyForge markers. Domains only: IP addresses are never blocked (CDNs share them)."; }
        Dim { text: "Layer 2 — browser policies (Settings → Blocking, on by default): browsers that use DNS-over-HTTPS bypass the hosts file, so while a block is active StudyForge also sets URL-block policies and turns DoH off in Firefox, Chrome, Chromium, Edge and Brave. Firefox may need a restart to pick up policy changes. Portable browsers, Flatpak/Snap browsers, VPNs and a determined administrator can still get around blocks."; }
    }
}

export component BlockingPage inherits ScrollView {
    VerticalLayout {
        spacing: 12px; padding-right: 10px;
        HelperCard { }
        HorizontalLayout {
            spacing: 12px; height: 520px;
            Card {
                width: 380px;
                VerticalLayout {
                    padding: 10px; spacing: 6px;
                    HorizontalLayout {
                        Text { text: "Block lists"; font-weight: 700; font-size: 16px; color: Theme.text; horizontal-stretch: 1; vertical-alignment: center; }
                        PrimaryButton { text: "+ New"; clicked => { AppState.new-list(); } }
                    }
                    Dim { text: "Tick the lists to use in your next focus session."; }
                    ScrollView {
                        vertical-stretch: 1;
                        VerticalLayout {
                            spacing: 2px;
                            for l in AppState.blocklists : ListRow { item: l; }
                        }
                    }
                }
            }
            if AppState.edit-list-id >= 0: ListEditor { horizontal-stretch: 1; }
            if AppState.edit-list-id < 0: Card { horizontal-stretch: 1; Text { text: "Select a list to view or edit it"; color: Theme.text-dim; horizontal-alignment: center; vertical-alignment: center; } }
        }
        ScheduleCard { height: 150px + AppState.schedules.length * 38px; }
        AllowlistCard { height: 330px; }
        PolicyNote { height: 190px; }
        Rectangle { height: 16px; }
    }
}

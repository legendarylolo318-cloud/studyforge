import { Palette } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { AppState } from "state.slint";
import { NavItem, Heading, Dim, Card, GhostButton, PrimaryButton } from "components.slint";
import { FocusPage } from "focus.slint";
import { SettingsPage } from "settings.slint";
import { DashboardPage } from "dashboard.slint";
import { TasksPage } from "tasks.slint";
import { NotesPage } from "notes.slint";
import { StatsPage } from "stats.slint";
import { FlashcardsPage } from "flashcards.slint";
import { BlockingPage } from "blocking.slint";
import { OverlayWindow } from "overlay.slint";
export { Theme, AppState, OverlayWindow }

export component AppWindow inherits Window {
    title: "StudyForge";
    min-width: 960px;
    min-height: 660px;
    preferred-width: 1100px;
    preferred-height: 740px;
    background: Theme.bg;
    icon: @image-url("../assets/icon.png");

    in-out property <int> page: 0;
    // Keep Slint's std-widgets palette in sync with our own theme (0 dark, 1 light, 2 system).
    property <int> theme-mode: Theme.mode;
    changed theme-mode => { root.apply-palette(); }
    init => { root.apply-palette(); }
    function apply-palette() {
        Palette.color-scheme = Theme.mode == 0 ? ColorScheme.dark : (Theme.mode == 1 ? ColorScheme.light : ColorScheme.unknown);
    }
    callback page-changed(int);
    callback quit-requested();

    HorizontalLayout {
        Rectangle {
            width: 210px;
            background: Theme.sidebar;
            VerticalLayout {
                padding: 14px;
                spacing: 4px;
                Text { text: "StudyForge"; font-size: 20px; font-weight: 800; color: Theme.accent; }
                Rectangle { height: 14px; }
                for name[i] in ["Dashboard", "Focus", "Flashcards", "Notes", "Tasks", "Blocking", "Stats", "Settings"] : NavItem {
                    label: name;
                    active: root.page == i;
                    clicked => { root.page = i; root.page-changed(i); }
                }
                Rectangle { vertical-stretch: 1; }
                Dim { text: AppState.status-line; }
            }
        }
        Rectangle {
            horizontal-stretch: 1;
            VerticalLayout {
                padding: 24px;
                spacing: 12px;
                Heading { text: ["Dashboard", "Focus", "Flashcards", "Notes", "Tasks", "Blocking", "Stats", "Settings"][root.page]; }
                Rectangle {
                    vertical-stretch: 1;
                    if root.page == 0: DashboardPage { }
                    if root.page == 1: FocusPage { }
                    if root.page == 2: FlashcardsPage { }
                    if root.page == 3: NotesPage { }
                    if root.page == 4: TasksPage { }
                    if root.page == 5: BlockingPage { }
                    if root.page == 6: StatsPage { }
                    if root.page == 7: SettingsPage { }
                }
            }
        }
    }
}

// Shown before anything else when another instance / computer holds the data folder.
export component LockWindow inherits Window {
    title: "StudyForge — data folder in use";
    width: 560px;
    height: 300px;
    background: Theme.bg;
    in property <string> message;
    in property <bool> can-take-over;
    callback take-over();
    callback quit();
    VerticalLayout {
        padding: 24px; spacing: 14px;
        Text { text: "⚠ Data folder is in use"; font-size: 20px; font-weight: 700; color: Theme.warn; }
        Text { text: root.message; color: Theme.text; wrap: word-wrap; vertical-stretch: 1; font-size: 14px; }
        Text {
            text: root.can-take-over ? "The lock looks stale (not refreshed for a while). If you are sure the other copy is closed, you can take over." : "Close StudyForge on the other computer first (or wait a couple of minutes if it crashed), then start again. Opening one database from two places at once can corrupt it.";
            color: Theme.text-dim; wrap: word-wrap; font-size: 12px;
        }
        HorizontalLayout {
            spacing: 10px; alignment: end;
            GhostButton { text: "Quit"; clicked => { root.quit(); } }
            if root.can-take-over: PrimaryButton { text: "Take over"; danger: true; clicked => { root.take-over(); } }
        }
    }
}

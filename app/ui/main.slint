import { Palette } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { AppState } from "state.slint";
import { NavItem, Heading, Dim, Card } from "components.slint";
import { FocusPage } from "focus.slint";
import { SettingsPage } from "settings.slint";
import { DashboardPage } from "dashboard.slint";
import { TasksPage } from "tasks.slint";
import { NotesPage } from "notes.slint";
import { StatsPage } from "stats.slint";
import { FlashcardsPage } from "flashcards.slint";
import { BlockingPage } from "blocking.slint";
import { OverlayWindow } from "overlay.slint";
export { Theme, AppState, OverlayWindow }

export component AppWindow inherits Window {
    title: "StudyForge";
    min-width: 960px;
    min-height: 660px;
    preferred-width: 1100px;
    preferred-height: 740px;
    background: Theme.bg;
    icon: @image-url("../assets/icon.png");

    in-out property <int> page: 0;
    // Keep Slint's std-widgets palette in sync with our own theme (0 dark, 1 light, 2 system).
    property <int> theme-mode: Theme.mode;
    changed theme-mode => { root.apply-palette(); }
    init => { root.apply-palette(); }
    function apply-palette() {
        Palette.color-scheme = Theme.mode == 0 ? ColorScheme.dark : (Theme.mode == 1 ? ColorScheme.light : ColorScheme.unknown);
    }
    callback page-changed(int);
    callback quit-requested();

    HorizontalLayout {
        Rectangle {
            width: 210px;
            background: Theme.sidebar;
            VerticalLayout {
                padding: 14px;
                spacing: 4px;
                Text { text: "StudyForge"; font-size: 20px; font-weight: 800; color: Theme.accent; }
                Rectangle { height: 14px; }
                for name[i] in ["Dashboard", "Focus", "Flashcards", "Notes", "Tasks", "Blocking", "Stats", "Settings"] : NavItem {
                    label: name;
                    active: root.page == i;
                    clicked => { root.page = i; root.page-changed(i); }
                }
                Rectangle { vertical-stretch: 1; }
                Dim { text: AppState.status-line; }
            }
        }
        Rectangle {
            horizontal-stretch: 1;
            VerticalLayout {
                padding: 24px;
                spacing: 12px;
                Heading { text: ["Dashboard", "Focus", "Flashcards", "Notes", "Tasks", "Blocking", "Stats", "Settings"][root.page]; }
                Rectangle {
                    vertical-stretch: 1;
                    if root.page == 0: DashboardPage { }
                    if root.page == 1: FocusPage { }
                    if root.page == 2: FlashcardsPage { }
                    if root.page == 3: NotesPage { }
                    if root.page == 4: TasksPage { }
                    if root.page == 5: BlockingPage { }
                    if root.page == 6: StatsPage { }
                    if root.page == 7: SettingsPage { }
                }
            }
        }
    }
}

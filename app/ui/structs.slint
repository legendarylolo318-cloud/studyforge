export struct SubjectItem { id: int, name: string, color: color }

export struct TipItem { id: int, text: string }

export struct SettingsData {
    work-mins: int,
    short-break-mins: int,
    long-break-mins: int,
    cycles-before-long: int,
    auto-start-next: bool,
    flow-reminder-mins: int,
    theme: int,
    accent: int,
    daily-goal-mins: int,
    weekly-goal-mins: int,
    streak-min-mins: int,
    day-start-hour: int,
    new-cards-per-day: int,
    master-volume: float,
    sound-during-work: bool,
    notify-sound: bool,
    notifications: bool,
    close-to-tray: bool,
    autostart: bool,
    hotkey: string,
    dnd-during-work: bool,
    browser-policies: bool,
    block-steam-client: bool,
    hard-mode-cooldown-mins: int,
    emergency-cooldown-mins: int,
    early-exit-challenge: bool,
    backup-daily: bool,
}

export struct TrackItem { id: string, name: string, volume: float }

export struct TodoItem { id: int, title: string, subject: string, subject-color: color, due: string, priority: int, done: bool, overdue: bool }
export struct NoteItem { id: int, title: string, snippet: string, subject: string, updated: string, selected: bool }
export struct MdBlock { kind: int, text: string, level: int, bold: bool, italic: bool, indent: int }
export struct BarItem { label: string, value: float, text: string, color: color }
export struct SessionRow { when: string, subject: string, goal: string, duration: string, outcome: string }
export struct DistractionRow { when: string, target: string, list: string, action: string }

export struct DeckRow { id: int, name: string, subject: string, total: int, due: int, new-count: int }
export struct CardRow { id: int, front: string, back: string, status: string }
export struct CsvRow { cols: [string] }

export struct ListItem { id: int, name: string, preset: bool, domains: int, processes: int, mode: int, selected: bool, steam: bool, editing: bool }
export struct ScheduleItem { id: int, name: string, days: string, time: string, lists: string, enabled: bool }
